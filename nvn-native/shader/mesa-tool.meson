# Appended only to an isolated, pinned Mesa source copy by build_ir3.py.
nvn_ir3_compile = executable(
  'nvn-ir3-compile', ['../ir3/nvn_ir3_compile.c', '../ir3/nvn_cs_artifact.cc', freedreno_xml_header_files],
  include_directories: [inc_freedreno, inc_include, inc_src],
  link_with: [libfreedreno_ir3, libfreedreno_layout],
  cpp_args: ['-DFD_NO_DEPRECATED_PACK'],
  dependencies: [idep_nir, idep_mesautil, idep_libir3decode],
  build_by_default: false,
)
