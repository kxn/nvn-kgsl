<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <Target Name="RequireShaderFrontend" BeforeTargets="PrepareForBuild"
          Condition="'$(NvnShaderFrontendRoot)' == ''">
    <Error Text="Set NvnShaderFrontendRoot to the pinned public shader frontend checkout." />
  </Target>
  <ItemGroup>
    <ProjectReference Include="$(NvnShaderFrontendRoot)/src/Ryujinx.Graphics.Shader/Ryujinx.Graphics.Shader.csproj" />
  </ItemGroup>
</Project>
